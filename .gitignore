# MATLAB generated files
*.asv
*.autosave
*.m~
*.mex*
slprj/
codegen/

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary and editor files
*.tmp
*.temp
*.bak
~$*
.vscode/

# Locally installed third-party toolbox (version and installation link are documented)
code/dependencies/chebfun/

# Generated figure products: retain publication-ready files, ignore diagnostics
code/figures/*/output/*
!code/figures/*/output/*.pdf
!code/figures/*/output/*.png
!code/figures/figure_11/output/Figure11.csv
code/figures/*/outputs/

# Generated table products: retain the deposited CSV and LaTeX tables
code/tables/*/output/*
!code/tables/*/output/*.csv
!code/tables/*/output/*.tex

# LaTeX build products
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
